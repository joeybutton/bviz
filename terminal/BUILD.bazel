load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "terminal",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_terminal",
    visibility = ["//ui/terminal:__pkg__"],
    deps = [
        "@bazel_build_event_proto//:bazel_build_event_rust_proto",
        "@crates//:alacritty_terminal",
        "@crates//:prost",
    ],
)

rust_test(
    name = "terminal_test",
    size = "small",
    compile_data = ["testdata/sample.bep"],
    crate = ":terminal",
)
