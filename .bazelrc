common --enable_platform_specific_config
common:linux --host_platform=//platforms:local_gnu

# Provide a libgcc_s stub for Rust's `-lgcc_s` link arg (hermetic-llvm "Usage with Rust").
build --@llvm//config:experimental_stub_libgcc_s=True

# Resolve protoc via the registered proto toolchain rather than the legacy hardcoded path.
common --incompatible_enable_proto_toolchain_resolution

# Overlap crate compilation across the dependency DAG: each crate emits .rmeta and
# its dependents start from that metadata instead of waiting for full codegen.
# Only under remote execution: built locally, a crate's metadata and its library
# resolve to versions rustc considers different, and its dependents then fail to
# find it (E0460, E0463).
build:remote --@rules_rs_rules_rust//rust/settings:pipelined_compilation

# Style and lint checks; both report a finding rather than rewriting the source.
build:rustfmt --aspects=@rules_rs_rules_rust//rust:defs.bzl%rustfmt_aspect
build:rustfmt --output_groups=rustfmt_checks
build:clippy --aspects=@rules_rs_rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=clippy_checks

build:perf_profile -c opt
build:perf_profile --@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Cdebuginfo=2
build:perf_profile --@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Cforce-frame-pointers=yes
build:perf_profile --@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Cstrip=none

build:bazel_profile --noslim_profile
build:bazel_profile --record_full_profiler_data
build:bazel_profile --experimental_profile_include_target_label
build:bazel_profile --experimental_profile_include_target_configuration

# Remote cache configuration.
import %workspace%/.bazelrc.remote

try-import %workspace%/user.bazelrc
