platform(
    name = "local_gnu",
    parents = ["@platforms//host"],
    constraint_values = [
        "@llvm//constraints/libc:gnu.2.28",
    ],
)

# BuildBuddy execution platform: the executor's own constraints plus its
# container image. The libc constraint must match what the registered toolchains
# build against (gnu.2.28) so they resolve here, and the image's glibc must
# cover that floor so the tools load on the executor; rbe-ubuntu24-04 ships 2.39.
# Wired in via --extra_execution_platforms in .bazelrc.remote.
platform(
    name = "rbe",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/libc:gnu.2.28",
    ],
    exec_properties = {
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04:latest",
    },
    visibility = ["//visibility:public"],
)
