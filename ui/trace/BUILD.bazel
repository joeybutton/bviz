load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_binary(
    name = "trace",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_ui_trace",
    deps = [
        "//trace/layout",
        "//trace/profile",
        "//ui/assets",
        "//ui/components",
        "//ui/shell",
        "//ui/theme",
        "@crates//:clap",
        "@crates//:gpui",
    ],
)

rust_test(
    name = "trace_test",
    crate = ":trace",
)
