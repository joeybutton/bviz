load("@rules_rs//rs:cargo_build_script.bzl", "cargo_build_script")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# The font/icon files come from Bazel http_archives; build.rs copies them into
# OUT_DIR so lib.rs can embed them with include_bytes!.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "EXEC_ROOT": "$${pwd}",
        "FONT_FILES": "$(execpaths @inter//:fonts) $(execpaths @jetbrains_mono//:fonts)",
        "ICON_FILES": "$(execpaths @phosphor//:icons)",
    },
    data = [
        "@inter//:fonts",
        "@jetbrains_mono//:fonts",
        "@phosphor//:icons",
    ],
)

rust_library(
    name = "assets",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_ui_assets",
    visibility = [
        "//ui/components:__pkg__",
        "//ui/console:__pkg__",
        "//ui/execlog:__pkg__",
        "//ui/graph:__pkg__",
        "//ui/playback:__pkg__",
        "//ui/shell:__pkg__",
        "//ui/trace:__pkg__",
        "//ui/workspace:__pkg__",
    ],
    deps = [
        ":build_script",
        "@crates//:gpui",
    ],
)

rust_test(
    name = "assets_test",
    crate = ":assets",
)
