load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_binary(
    name = "graph",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_ui_graph",
    deps = [
        "//graph/layout",
        "//ui/assets",
        "//ui/components",
        "//ui/shell",
        "//ui/theme",
        "@crates//:clap",
        "@crates//:gpui",
    ],
)

rust_test(
    name = "graph_test",
    crate = ":graph",
)
