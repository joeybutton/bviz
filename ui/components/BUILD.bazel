load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# text_input.rs was written from gpui's input example, so it carries that
# example's terms rather than the crate's own.
filegroup(
    name = "text_input_src",
    srcs = ["src/text_input.rs"],
    package_metadata = ["//LICENSES:gpui"],
)

rust_library(
    name = "components",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/text_input.rs"],
    ) + [":text_input_src"],
    crate_name = "bviz_ui_components",
    visibility = [
        "//ui/graph:__pkg__",
        "//ui/shell:__pkg__",
        "//ui/terminal:__pkg__",
        "//ui/trace:__pkg__",
        "//ui/workspace:__pkg__",
    ],
    deps = [
        "//ui/assets",
        "//ui/theme",
        "@crates//:gpui",
    ],
)

rust_test(
    name = "components_test",
    crate = ":components",
)
