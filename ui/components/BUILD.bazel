load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "components",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_ui_components",
    visibility = [
        "//ui/graph:__pkg__",
        "//ui/shell:__pkg__",
        "//ui/terminal:__pkg__",
        "//ui/trace:__pkg__",
    ],
    deps = [
        "//ui/assets",
        "//ui/theme",
        "@crates//:gpui",
    ],
)

rust_test(
    name = "components_test",
    crate = ":components",
)
