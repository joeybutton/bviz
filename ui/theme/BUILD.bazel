load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "theme",
    srcs = glob(["src/*.rs"]),
    compile_data = ["//ui/theme/themes:one"],
    crate_name = "bviz_ui_theme",
    visibility = [
        "//ui/components:__pkg__",
        "//ui/console:__pkg__",
        "//ui/execlog:__pkg__",
        "//ui/graph:__pkg__",
        "//ui/playback:__pkg__",
        "//ui/shell:__pkg__",
        "//ui/spawn_phase:__pkg__",
        "//ui/trace:__pkg__",
        "//ui/workspace:__pkg__",
    ],
    deps = [
        "@crates//:gpui",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "theme_test",
    crate = ":theme",
)
