load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "workspace",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_ui_workspace",
    visibility = [
        "//ui/graph:__pkg__",
        "//ui/terminal:__pkg__",
        "//ui/trace:__pkg__",
    ],
    deps = [
        "//ui/shell",
        "@crates//:gpui",
    ],
)

rust_test(
    name = "workspace_test",
    crate = ":workspace",
)
