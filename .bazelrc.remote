build:remote --config=remote-bes --config=remote-cache --config=remote-exec

# Diagnostic logs for troubleshooting remote builds.

# docs: https://bazel.build/reference/command-line-reference#param-remote-grpc-log
build:remote --remote_grpc_log=bazel-remote-grpc.log
# docs: https://bazel.build/reference/command-line-reference#param-no-execution-log-compact-file
build:remote --execution_log_compact_file=execution_log.binpb.zst

# Build event stream setup.

# docs: https://bazel.build/reference/command-line-reference#param-remote-build-event-upload
build:remote-bes --remote_build_event_upload=minimal
# docs: https://bazel.build/reference/command-line-reference#param-no-slim-profile
build:remote-bes --noslim_profile
# docs: https://bazel.build/reference/command-line-reference#param-no-experimental-profile-include-target-label
build:remote-bes --experimental_profile_include_target_label
# docs: https://bazel.build/reference/command-line-reference#param-no-experimental-profile-include-primary-output
build:remote-bes --experimental_profile_include_primary_output
# docs: https://bazel.build/reference/command-line-reference#param-no-legacy-important-outputs
build:remote-bes --nolegacy_important_outputs

# docs: https://bazel.build/reference/command-line-reference#param-bes-results-url
build:remote-bes --bes_results_url=https://yume.buildbuddy.io/invocation/
# docs: https://bazel.build/reference/command-line-reference#param-bes-backend
build:remote-bes --bes_backend=grpcs://yume.buildbuddy.io

# Remote cache setup.

# docs: https://bazel.build/reference/command-line-reference#param-remote-cache
build:remote-cache --remote_cache=grpcs://yume.buildbuddy.io
# docs: https://bazel.build/reference/command-line-reference#param-no-remote-cache-compression
build:remote-cache --remote_cache_compression
# docs: https://bazel.build/reference/command-line-reference#param-no-experimental-remote-cache-chunking
build:remote-cache --experimental_remote_cache_chunking
# docs: https://bazel.build/reference/command-line-reference#param-remote-download-toplevel
build:remote-cache --remote_download_toplevel
# bazel_env requires sha256sum on disk
# docs: https://bazel.build/reference/command-line-reference#param-remote-download-regex
build:remote-cache --remote_download_regex=.*/sha256sum(\.exe)?$
# docs: https://bazel.build/reference/command-line-reference#param-remote-timeout
build:remote-cache --remote_timeout=3600
# docs: https://bazel.build/reference/command-line-reference#param-experimental-remote-cache-ttl
build:remote-cache --experimental_remote_cache_ttl=3h
# docs: https://bazel.build/reference/command-line-reference#param-no-experimental-remote-cache-lease-extension
build:remote-cache --experimental_remote_cache_lease_extension

# Remote execution setup.

# docs: https://bazel.build/reference/command-line-reference#param-remote-executor
build:remote-exec --remote_executor=grpcs://yume.buildbuddy.io
# docs: https://bazel.build/reference/command-line-reference#param-remote-downloader
build:remote-exec --experimental_remote_downloader=grpcs://yume.buildbuddy.io

# docs: https://bazel.build/reference/command-line-reference#param-extra-execution-platforms
build:remote-exec --extra_execution_platforms=//platforms:rbe

# docs: https://bazel.build/reference/command-line-reference#param-jobs
build:remote-exec --jobs=80
