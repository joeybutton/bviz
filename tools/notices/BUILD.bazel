load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

exports_files(["components.json"])

rust_binary(
    name = "notices",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_notices",
    deps = [
        "@crates//:clap",
        "@crates//:packageurl",
        "@crates//:semver",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:spdx",
    ],
)

rust_test(
    name = "notices_test",
    crate = ":notices",
    data = ["@spdx_license_list//:texts"],
    env = {"SPDX_TEXTS": "$(rlocationpaths @spdx_license_list//:texts)"},
    deps = ["@rules_rs_rules_rust//rust/runfiles"],
)
