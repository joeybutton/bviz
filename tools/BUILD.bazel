load("@bazel_env.bzl", "bazel_env")
load("@multitool//:tools.bzl", MULTITOOL_TOOLS = "TOOLS")
load(":bazel_env.bzl", "local_exec_tool")

local_exec_tool(
    name = "cargo",
    actual = "@rules_rs_rules_rust//tools/upstream_wrapper:cargo",
    tags = ["manual"],
)

local_exec_tool(
    name = "rustc",
    actual = "@rules_rs_rules_rust//tools/upstream_wrapper:rustc",
    tags = ["manual"],
)

local_exec_tool(
    name = "rustfmt",
    actual = "@rules_rs_rules_rust//tools/upstream_wrapper:rustfmt",
    tags = ["manual"],
)

# `bazel run //tools:bazel_env` to update / install the direnv environment.
bazel_env(
    name = "bazel_env",
    toolchains = {
    },
    tools = {
        "cargo": ":cargo",
        "multitool": MULTITOOL_TOOLS["multitool"],
        "rust-analyzer": MULTITOOL_TOOLS["rust-analyzer"],
        "rustc": ":rustc",
        "rustfmt": ":rustfmt",
    },
    watch_files = {
        "_common": [
            "MODULE.bazel",
            "MODULE.bazel.lock",
            "multitool.lock.json",
            "tools/BUILD.bazel",
        ],
    },
)
