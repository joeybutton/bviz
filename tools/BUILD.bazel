load("@bazel_env.bzl", "bazel_env")
load("@multitool//:tools.bzl", MULTITOOL_TOOLS = "TOOLS")

# `bazel run //tools:bazel_env` to update / install the direnv environment.
bazel_env(
    name = "bazel_env",
    toolchains = {
    },
    tools = {
        "cargo": "@rules_rs_rules_rust//tools/upstream_wrapper:cargo",
        "multitool": MULTITOOL_TOOLS["multitool"],
        "rust-analyzer": MULTITOOL_TOOLS["rust-analyzer"],
        "rustc": "@rules_rs_rules_rust//tools/upstream_wrapper:rustc",
        "rustfmt": "@rules_rs_rules_rust//tools/upstream_wrapper:rustfmt",
    },
    watch_files = {
        "_common": [
            "MODULE.bazel",
            "MODULE.bazel.lock",
            "multitool.lock.json",
            "tools/BUILD.bazel",
        ],
    },
)
