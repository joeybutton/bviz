load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")
load("//tools/notices:notices.bzl", "third_party_notices")

rust_binary(
    name = "bviz",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz",
    visibility = [
        "//:__pkg__",
        "//dist:__pkg__",
    ],
    deps = [
        "//alloc",
        "//cli",
        "//invocation",
        "//ui/console:console_lib",
        "//ui/execlog:execlog_lib",
        "//ui/graph:graph_lib",
        "//ui/playback",
        "//ui/trace:trace_lib",
        "//ui/workspace",
        "@crates//:clap",
        "@crates//:gpui",
    ] + select({
        # The page's entry points: see src/web.rs.
        "@platforms//cpu:wasm32": [
            "//util/files",
            "//util/parallel",
            "@crates//:gpui_platform",
            "@crates//:wasm-bindgen",
        ],
        "//conditions:default": [],
    }),
)

rust_test(
    name = "bviz_test",
    size = "small",
    crate = ":bviz",
    deps = ["//ui/components"],
)

third_party_notices(
    name = "third_party_notices",
    binary = ":bviz",
    denied_licences = [
        "AGPL-",
        "GPL-",
        "LGPL-",
    ],
    own_package_metadata = "//:package_metadata",
    preferred_licences = ["Apache-2.0"],
    repository_package_metadata = [
        "//third_party:libffi_package_metadata",
        "//third_party:protobuf_package_metadata",
        "//third_party:rules_rust_package_metadata",
        "//third_party:wayland_package_metadata",
        "//third_party:xkbcommon_package_metadata",
        "//third_party:zed_package_metadata",
    ],
    toolchain_package_metadata = ["//third_party:rust_std_package_metadata"],
    visibility = ["//dist:__pkg__"],
)

# The same app, built for the browser: rust_wasm_bindgen compiles :bviz for
# wasm32-unknown-unknown and emits the ES module that starts it.
rust_wasm_bindgen(
    name = "bviz_web",
    target = "web",
    visibility = ["//web:__pkg__"],
    wasm_file = ":bviz",
)
