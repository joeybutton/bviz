load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "alloc",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_alloc",
    visibility = [
        "//bviz:__pkg__",
        "//execlog:__pkg__",
        "//trace/layout:__pkg__",
        "//trace/profile:__pkg__",
        "//ui/execlog:__pkg__",
        "//ui/trace:__pkg__",
    ],
    deps = select({
        "@platforms//os:linux": ["@crates//:libc"],
        "//conditions:default": [],
    }),
)

rust_test(
    name = "alloc_test",
    size = "small",
    crate = ":alloc",
)
