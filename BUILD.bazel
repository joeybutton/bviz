load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")

alias(
    name = "bviz",
    actual = "//bviz",
)

buildifier(
    name = "buildifier",
    exclude_patterns = ["./bazel-*/**"],
    lint_mode = "fix",
    mode = "fix",
)

buildifier_test(
    name = "buildifier_test",
    lint_mode = "warn",
    mode = "diff",
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)
