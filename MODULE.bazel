module(
    name = "bazel_viz",
    version = "0.0.0",
)

bazel_dep(name = "llvm", version = "0.7.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "protobuf", version = "35.0", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rs", version = "0.0.53")

rs_toolchains = use_extension("@rules_rs//rs/experimental/toolchains:module_extension.bzl", "toolchains")
rs_toolchains.toolchain(
    edition = "2024",
    version = "1.94.0",
)
use_repo(rs_toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//:all")

# Link Rust binaries with llvm/lld rather than the autodetected system cc.
register_toolchains("@llvm//toolchain:all")

PLATFORM_TRIPLES = [
    "x86_64-unknown-linux-gnu",
]

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
    use_experimental_platforms = True,
)
use_repo(crate, "crates")

rules_rust = use_extension("@rules_rs//rs/experimental:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, rules_rs_rules_rust = "rules_rust")

new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

# query (build.proto), cquery + aquery (analysis_v2.proto) and their transitive
# stardoc_output.proto, for parsing `--output=streamed_proto`.
new_git_repository(
    name = "bazel_query_proto",
    build_file = "//3rd-party:bazel_query_proto.BUILD",
    commit = "43f23b4349195333b97bef77cc62c2ea4ffd8e91",  # 9.0.1
    remote = "https://github.com/bazelbuild/bazel.git",
    sparse_checkout_patterns = [
        "src/main/protobuf/analysis_v2.proto",
        "src/main/protobuf/build.proto",
        "src/main/protobuf/stardoc_output.proto",
    ],
)

bazel_dep(name = "bazel_env.bzl", version = "0.7.2", dev_dependency = True)
bazel_dep(name = "rules_multitool", version = "1.11.1", dev_dependency = True)

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")
