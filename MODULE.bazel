module(
    name = "bviz",
    version = "0.0.0",
)

bazel_dep(name = "bazel_lib", version = "3.2.2")
bazel_dep(name = "llvm", version = "0.8.9")
bazel_dep(name = "package_metadata", version = "0.0.13")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "protobuf", version = "35.0", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rs", version = "0.0.110")
bazel_dep(name = "tar.bzl", version = "0.10.4")

# System libraries for gpui's Wayland backend, provided via the BCR.
bazel_dep(name = "wayland", version = "1.24.0.bcr.1")
bazel_dep(name = "xkbcommon", version = "1.9.2.bcr.beta.1")

rs_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rs_toolchains.toolchain(
    edition = "2024",
    version = "1.95.0",
)
use_repo(rs_toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

# Link Rust binaries with llvm/lld rather than the autodetected system cc.
register_toolchains("@llvm//toolchain:all")

# The macOS sysroot the llvm module fetches carries a small default set of
# frameworks, which this tag replaces wholesale; the defaults are therefore
# repeated alongside the ones gpui's macOS backend and the media crate bind.
# ColorSync, FontServices and ImageIO come from the sysroot itself:
# ApplicationServices symlinks into them, and Bazel refuses to act on a dangling
# symlink. CFNetwork, CoreImage and CoreServices are re-exported by stub
# libraries lld has to resolve; OpenGL is what the cgl crate binds.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(names = [
    "AppKit",
    "ApplicationServices",
    "Carbon",
    "CFNetwork",
    "ColorSync",
    "CoreFoundation",
    "CoreGraphics",
    "CoreImage",
    "CoreMedia",
    "CoreServices",
    "CoreText",
    "CoreVideo",
    "FontServices",
    "Foundation",
    "ImageIO",
    "Kernel",
    "Metal",
    "MetalPerformanceShaders",
    "OSLog",
    "OpenGL",
    "QuartzCore",
    "Security",
    "SystemConfiguration",
])

DARWIN_TRIPLES = [
    "aarch64-apple-darwin",
    "x86_64-apple-darwin",
]

LINUX_TRIPLES = [
    "x86_64-unknown-linux-gnu",
]

PLATFORM_TRIPLES = DARWIN_TRIPLES + LINUX_TRIPLES

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
)

# InteractiveExternalPortPositioner holds a node's lock while calling the searches
# that re-lock that same node, and elk-rs's node lock is a plain parking_lot mutex,
# so the thread blocks on itself. Every layered layout that runs an interactive
# phase and has an edge crossing a container boundary reaches it and hangs.
crate.annotation(
    crate = "org-eclipse-elk-alg-layered",
    patch_args = ["-p1"],
    patches = ["//patches/elk-rs:elk-rs-reentrant-external-port-lock.patch"],
)

# Load libfontconfig at runtime (dlopen) instead of linking it via pkg-config.
# On Apple platforms zed-font-kit draws its fonts from Core Text and never binds
# fontconfig, so the feature is only meaningful for Linux.
crate.annotation_select(
    crate = "zed-font-kit",
    crate_features = ["source-fontconfig-dlopen"],
    triples = LINUX_TRIPLES,
)

# Fixes and startup tuning for gpui's Linux backend:
# - untile-restore: gpui restores the floating window size on un-maximize but not
#   un-tile, leaving the window stuck at the tiled size; preserve window_bounds
#   while tiled so it restores on untile.
# - clear-hover-on-leave: gpui recomputes hover only on mouse-move, so a pointer
#   leaving the window leaves the last element hovered; synthesize an off-screen
#   move on wl_pointer.leave to clear it.
# - embedded-fonts-only: construct the text system with an empty font DB to skip
#   the ~700ms startup enumeration of every system font on the main thread; the
#   app registers its own embedded faces, which cover its ASCII/Latin-1 labels.
# - platform-drag: gpui's Wayland backend binds wl_data_device for the clipboard
#   and for incoming file drops alone; carry a drag the application offers over
#   on a wl_data_source with an icon surface of its own, and report a drag
#   carrying the mime type the application takes to whichever window it is
#   carried over.
crate.annotation(
    crate = "gpui_linux",
    patch_args = ["-p1"],
    patches = [
        "//patches/gpui_linux:gpui_linux-untile-restore.patch",
        "//patches/gpui_linux:gpui_linux-clear-hover-on-leave.patch",
        "//patches/gpui_linux:gpui_linux-embedded-fonts-only.patch",
        "//patches/gpui_linux:gpui_linux-platform-drag.patch",
    ],
)

# gpui_macos's build script generates the C header its Metal shaders share with
# Rust by running cbindgen over gpui's sources. rules_rs does not surface a git
# crate's build-dependencies, so //tools/scene_header generates the header and the
# build script takes its path from GPUI_SCENE_HEADER. The runtime_shaders feature
# stitches that header into the shader source for the app to compile at run time;
# the other path shells out to `xcrun metal`, which only macOS has.
#
# rustc compiles against an absolute CARGO_MANIFEST_DIR, and gpui retains that
# value in GPUI_MANIFEST_DIR, which bakes the exec root into every build of the
# crate. Point it at the manifest's path within gpui's source tree so the
# compiled output stays independent of where the build ran.
#
# gpui carries a drag to its own views and never to the window system, so
# nothing outside the window a gesture started in hears of one, and nothing it
# draws is reachable past that window's edge. The platform-drag patch gives a
# window the requests to offer a gesture to the window system, to say which mime
# type it takes a drag under, and to hear what a drag the window system carries
# does; a backend that implements none of them takes no gesture and says so.
# Rasterizing a glyph goes with them: what a window system draws for a drag is
# an image, and gpui's text system is where the application's own faces are
# loaded.
crate.annotation(
    additive_build_file_content = """filegroup(
    name = "scene_src",
    srcs = ["src/scene.rs"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "shader_type_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)""",
    crate = "gpui",
    extra_aliased_targets = {
        "gpui_scene_src": "scene_src",
        "gpui_shader_type_srcs": "shader_type_srcs",
    },
    patch_args = ["-p1"],
    patches = ["//patches/gpui:gpui-platform-drag.patch"],
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/gpui"},
)
crate.annotation(
    additive_build_file_content = """filegroup(
    name = "metal_renderer_src",
    srcs = ["src/metal_renderer.rs"],
    visibility = ["//visibility:public"],
)""",
    build_script_data = ["//tools/scene_header:scene_h"],
    # buildifier: disable=canonical-repository
    # Location expressions resolve in the crate repository, which has no apparent
    # name for bviz's own.
    build_script_env = {"GPUI_SCENE_HEADER": "$(execpath @@//tools/scene_header:scene_h)"},
    crate = "gpui_macos",
    extra_aliased_targets = {"gpui_macos_metal_renderer_src": "metal_renderer_src"},
    patch_args = ["-p1"],
    patches = ["//patches/gpui_macos:gpui_macos-prebuilt-scene-header.patch"],
)
crate.annotation_select(
    crate = "gpui_macos",
    crate_features = ["runtime_shaders"],
    triples = DARWIN_TRIPLES,
)

# Link the BCR system libraries (aliased under //third_party) into the -sys crates
# that bind them.
#
# The patch removes xkbcommon's X11 FFI, which links the unavailable
# libxkbcommon-x11; gpui uses only Wayland, so it is dead code. Disabling the x11
# feature instead would not work: it comes from gpui_linux's dependency spec, and
# rules_rs resolves features from unpatched metadata.
crate.annotation(
    crate = "xkbcommon",
    patch_args = ["-p1"],
    patches = ["//patches/xkbcommon:xkbcommon-drop-x11.patch"],
    deps = ["//third_party:xkbcommon"],
)
crate.annotation(
    crate = "wayland-sys",
    gen_build_script = "off",  # otherwise it pkg-config-probes libwayland
    deps = [
        "//third_party:wayland_client",
        "//third_party:wayland_cursor",
    ],
)

# rav1e records its build environment through the built crate, whose RUSTC entry
# is the absolute path of the compiler and so bakes the exec root into the
# crate. built takes a BUILT_OVERRIDE_<package>_<field> for each entry it
# records, and demands RUSTC_VERSION alongside any RUSTC override; the values
# only surface in rav1e's own version banner, which this build never runs.
crate.annotation(
    build_script_env = {
        "BUILT_OVERRIDE_rav1e_RUSTC": "rustc",
        "BUILT_OVERRIDE_rav1e_RUSTC_VERSION": "unknown",
    },
    crate = "rav1e",
)

# media generates its CoreMedia declarations with bindgen, which the patch
# removes; turning the build script off keeps bindgen out of the build.
crate.annotation(
    crate = "media",
    gen_build_script = "off",
    patch_args = ["-p1"],
    patches = ["//patches/media:media-drop-the-generated-core-media-bindings.patch"],
)

# freetype-sys compiles in C++ mode, so the cc crate would link GNU libstdc++.
# The hermetic toolchain ships libc++ instead, so emit no explicit C++ stdlib and
# let freetype's symbols resolve against the toolchain's libc++.
crate.annotation(
    build_script_env = {"CXXSTDLIB": ""},
    crate = "freetype-sys",
)

# wgpu's `vulkan` feature does not propagate to wgpu-core/wgpu-hal through wgpu's
# platform shim under rules_rs resolution, so no GPU backend gets compiled and
# surface creation fails. Enable the Vulkan backend on the crates that gate it.
crate.annotation_select(
    crate = "wgpu-core",
    crate_features = ["vulkan"],
    triples = LINUX_TRIPLES,
)
crate.annotation_select(
    crate = "wgpu-hal",
    crate_features = ["vulkan"],
    triples = LINUX_TRIPLES,
)

# objc-sys locates its ObjFW compatibility headers through a build-time
# env!("CARGO_MANIFEST_DIR"), which bakes the exec root into the compiled build
# script. Only the ObjFW runtime reads those headers and this build targets
# Apple's, so a relative manifest dir leaves the output independent of where the
# build ran.
crate.annotation(
    crate = "objc-sys",
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
)
crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)
use_repo(crate, "crates")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, rules_rs_rules_rust = "rules_rust")

rules_rust_prost = use_extension("@rules_rs//rs:rules_rust_prost.bzl", "rules_rust_prost")
use_repo(rules_rust_prost, "rules_rust_prost")

register_toolchains(
    "@//proto_toolchain:prost_toolchain",
    "@//proto_toolchain:proto_toolchain",
)

