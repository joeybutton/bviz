module(
    name = "bazel_viz",
    version = "0.0.0",
)

bazel_dep(name = "libdeflate", version = "1.25")

# The libdeflate BCR overlay's cc_library omits the gzip and CRC-32 units, so its
# libdeflate_gzip_* entry points are unlinkable; patch them into the sources.
single_version_override(
    module_name = "libdeflate",
    patch_strip = 1,
    patches = ["//patches:libdeflate-add-gzip.patch"],
    version = "1.25",
)
bazel_dep(name = "llvm", version = "0.7.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "protobuf", version = "35.0", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rs", version = "0.0.53")

# System libraries for gpui's Wayland backend, provided via the BCR.
bazel_dep(name = "wayland", version = "1.24.0.bcr.1")
bazel_dep(name = "xkbcommon", version = "1.9.2.bcr.beta.1")

rs_toolchains = use_extension("@rules_rs//rs/experimental/toolchains:module_extension.bzl", "toolchains")
rs_toolchains.toolchain(
    edition = "2024",
    version = "1.95.0",
)
use_repo(rs_toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//:all")

# Link Rust binaries with llvm/lld rather than the autodetected system cc.
register_toolchains("@llvm//toolchain:all")

PLATFORM_TRIPLES = [
    "x86_64-unknown-linux-gnu",
]

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
    use_experimental_platforms = True,
)

# Load libfontconfig at runtime (dlopen) instead of linking it via pkg-config.
crate.annotation(
    crate = "zed-font-kit",
    crate_features = ["source-fontconfig-dlopen"],
)

# Two fixes to gpui's Wayland backend:
# - untile-restore: gpui restores the floating window size on un-maximize but not
#   un-tile, leaving the window stuck at the tiled size; preserve window_bounds
#   while tiled so it restores on untile.
# - clear-hover-on-leave: gpui recomputes hover only on mouse-move, so a pointer
#   leaving the window leaves the last element hovered; synthesize an off-screen
#   move on wl_pointer.leave to clear it.
crate.annotation(
    crate = "gpui_linux",
    patches = [
        "@@//patches:gpui_linux-untile-restore.patch",
        "@@//patches:gpui_linux-clear-hover-on-leave.patch",
    ],
    patch_args = ["-p1"],
)

# Link the BCR system libraries (aliased under //third_party) into the -sys crates
# that bind them.
#
# The patch removes xkbcommon's X11 FFI, which links the unavailable
# libxkbcommon-x11; gpui uses only Wayland, so it is dead code. Disabling the x11
# feature instead would not work: it comes from gpui_linux's dependency spec, and
# rules_rs resolves features from unpatched metadata.
crate.annotation(
    crate = "xkbcommon",
    patches = ["@@//patches:xkbcommon-drop-x11.patch"],
    patch_args = ["-p1"],
    deps = ["@@//third_party:xkbcommon"],
)
crate.annotation(
    crate = "wayland-sys",
    gen_build_script = "off",  # otherwise it pkg-config-probes libwayland
    deps = [
        "@@//third_party:wayland_client",
        "@@//third_party:wayland_cursor",
    ],
)

# freetype-sys compiles in C++ mode, so the cc crate would link GNU libstdc++.
# The hermetic toolchain ships libc++ instead, so emit no explicit C++ stdlib and
# let freetype's symbols resolve against the toolchain's libc++.
crate.annotation(
    crate = "freetype-sys",
    build_script_env = {"CXXSTDLIB": ""},
)

# wgpu's `vulkan` feature does not propagate to wgpu-core/wgpu-hal through wgpu's
# platform shim under rules_rs resolution, so no GPU backend gets compiled and
# surface creation fails. Enable the Vulkan backend on the crates that gate it.
crate.annotation(
    crate = "wgpu-core",
    crate_features = ["vulkan"],
)
crate.annotation(
    crate = "wgpu-hal",
    crate_features = ["vulkan"],
)

crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)
use_repo(crate, "crates")

rules_rust = use_extension("@rules_rs//rs/experimental:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, rules_rs_rules_rust = "rules_rust")

rules_rust_prost = use_extension("@rules_rs//rs/experimental:rules_rust_prost.bzl", "rules_rust_prost")
use_repo(rules_rust_prost, "rules_rust_prost")

register_toolchains(
    "@//proto_toolchain:prost_toolchain",
    "@//proto_toolchain:proto_toolchain",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Application fonts: Inter for UI text, JetBrains Mono for monospace.
http_archive(
    name = "inter",
    build_file = "//3rd-party:inter.BUILD",
    sha256 = "9883fdd4a49d4fb66bd8177ba6625ef9a64aa45899767dde3d36aa425756b11e",
    url = "https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip",
)

http_archive(
    name = "jetbrains_mono",
    build_file = "//3rd-party:jetbrains_mono.BUILD",
    sha256 = "6f6376c6ed2960ea8a963cd7387ec9d76e3f629125bc33d1fdcd7eb7012f7bbf",
    url = "https://github.com/JetBrains/JetBrainsMono/releases/download/v2.304/JetBrainsMono-2.304.zip",
)

# Phosphor icon set (regular weight), rendered as SVGs through gpui's asset source.
http_archive(
    name = "phosphor",
    build_file = "//3rd-party:phosphor.BUILD",
    sha256 = "8b4dd9afb96b50c92a613f5786af6a7dcff6e416442c42c12ed831cea050a698",
    strip_prefix = "core-2.0.8",
    url = "https://github.com/phosphor-icons/core/archive/refs/tags/v2.0.8.tar.gz",
)

new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

# query (build.proto), cquery + aquery (analysis_v2.proto) and their transitive
# stardoc_output.proto, for parsing `--output=streamed_proto`.
new_git_repository(
    name = "bazel_query_proto",
    build_file = "//3rd-party:bazel_query_proto.BUILD",
    commit = "43f23b4349195333b97bef77cc62c2ea4ffd8e91",  # 9.0.1
    remote = "https://github.com/bazelbuild/bazel.git",
    sparse_checkout_patterns = [
        "src/main/protobuf/analysis_v2.proto",
        "src/main/protobuf/build.proto",
        "src/main/protobuf/stardoc_output.proto",
    ],
)

new_git_repository(
    name = "bazel_build_event_proto",
    build_file = "//3rd-party:bazel_build_event_proto.BUILD",
    commit = "43f23b4349195333b97bef77cc62c2ea4ffd8e91",  # 9.0.1
    remote = "https://github.com/bazelbuild/bazel.git",
    sparse_checkout_patterns = [
        "src/main/java/com/google/devtools/build/lib/buildeventstream/proto/build_event_stream.proto",
        "src/main/java/com/google/devtools/build/lib/packages/metrics/package_load_metrics.proto",
        "src/main/java/com/google/devtools/build/lib/skyframe/serialization/analysis/proto/analysis_cache_service_metadata_status.proto",
        "src/main/java/com/google/devtools/build/lib/skyframe/serialization/analysis/proto/analysis_cache_service_miss_reason.proto",
        "src/main/protobuf/action_cache.proto",
        "src/main/protobuf/command_line.proto",
        "src/main/protobuf/failure_details.proto",
        "src/main/protobuf/invocation_policy.proto",
        "src/main/protobuf/option_filters.proto",
        "src/main/protobuf/strategy_policy.proto",
    ],
)

bazel_dep(name = "bazel_env.bzl", version = "0.7.2", dev_dependency = True)
bazel_dep(name = "rules_multitool", version = "1.11.1", dev_dependency = True)

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")
