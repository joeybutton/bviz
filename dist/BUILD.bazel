load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@tar.bzl", "tar")
load(":source.bzl", "source_file")

# Fixed entry timestamp, so an archive's bytes depend only on its contents.
MTIME = 1672560000

TARGET_PLATFORMS = {
    "linux-arm64": "//platforms:linux_arm64",
    "linux-x86_64": "//platforms:linux_x86_64",
    "macos-arm64": "//platforms:macos_arm64",
    "macos-x86_64": "//platforms:macos_x86_64",
}

[
    platform_transition_filegroup(
        name = "{}_{}".format(name, suffix),
        srcs = [src],
        tags = ["manual"],
        target_platform = platform,
    )
    for suffix, platform in TARGET_PLATFORMS.items()
    for name, src in {
        "bviz": "//bviz",
        "notices": "//bviz:third_party_notices",
    }.items()
]

source_file(
    name = "SOURCE",
    repository = "https://github.com/yume-ag/bviz",
    tags = ["manual"],
)

# Only the sources carry the platform transition: these rules stay in the
# baseline configuration, so each archive lands at a fixed bazel-bin/dist path
# that the nightly workflow can name.
[
    tar(
        name = "bviz-{}".format(suffix),
        srcs = [
            ":bviz_{}".format(suffix),
            ":notices_{}".format(suffix),
            ":SOURCE",
            "//:LICENSE",
            "//:NOTICE",
        ],
        compress = "gzip",
        mtree = [
            "bviz uid=0 gid=0 time={} mode=0755 type=file content=$(execpath :bviz_{})".format(MTIME, suffix),
            "LICENSE uid=0 gid=0 time={} mode=0644 type=file content=$(execpath //:LICENSE)".format(MTIME),
            "NOTICE uid=0 gid=0 time={} mode=0644 type=file content=$(execpath //:NOTICE)".format(MTIME),
            "SOURCE uid=0 gid=0 time={} mode=0644 type=file content=$(execpath :SOURCE)".format(MTIME),
            "THIRD_PARTY_NOTICES uid=0 gid=0 time={} mode=0644 type=file content=$(execpath :notices_{})".format(MTIME, suffix),
        ],
        tags = ["manual"],
    )
    for suffix in TARGET_PLATFORMS
]

filegroup(
    name = "dist",
    srcs = [":bviz-{}".format(suffix) for suffix in TARGET_PLATFORMS],
    tags = ["manual"],
)
