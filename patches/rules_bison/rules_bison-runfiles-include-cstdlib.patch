Include <cstdlib> for getenv

The runfiles shim calls getenv without including <cstdlib>, which libc++ 23
no longer pulls in transitively through <string>.

--- a/bison/internal/bazel_runfiles.patch
+++ b/bison/internal/bazel_runfiles.patch
@@ -1,8 +1,9 @@
 --- /dev/null
 +++ src/bazel_runfiles.cc
-@@ -0,0 +1,75 @@
+@@ -0,0 +1,76 @@
 +#include "tools/cpp/runfiles/runfiles.h"
 +
++#include <cstdlib>
 +#include <cstring>
 +#include <string>
 +
