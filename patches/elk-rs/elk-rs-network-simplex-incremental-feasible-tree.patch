+/// An edge between the tree `feasible_tree` grows and a node outside it, at
+/// its endpoint in the tree.
+#[derive(Clone, Copy)]
+struct TreeExit {
+    node: usize,
+    edge: usize,
+    /// Where the edge stands in the node's `node_edges`.
+    at: usize,
+}
+
+/// The edges between the tree `feasible_tree` grows and the nodes outside it,
+/// by slack. Only the tree's nodes move, and all by the same amount, so each
+/// edge is kept by its slack relative to how far the tree has moved in all,
+/// which stays fixed while it crosses.
+#[derive(Default)]
+struct CrossingEdges {
+    /// Edges leaving the tree, by slack plus `moved`, then index.
+    leaving: BTreeSet<(i64, usize)>,
+    /// Edges entering the tree, by slack less `moved`, then index.
+    entering: BTreeSet<(i64, usize)>,
+    /// The key each crossing edge is held by.
+    key: Vec<i64>,
+    /// Where each crossing edge stands in the `node_edges` of its endpoint in
+    /// the tree.
+    at: Vec<usize>,
+    moved: i64,
+}
+
+impl CrossingEdges {
+    fn new(edge_count: usize) -> Self {
+        CrossingEdges {
+            key: vec![0; edge_count],
+            at: vec![0; edge_count],
+            ..CrossingEdges::default()
+        }
+    }
+
+    /// Takes in edge `eid`, which runs between the tree and a node outside it
+    /// and stands at `at` in the `node_edges` of its endpoint in the tree.
+    fn insert(&mut self, simplex: &NetworkSimplex, eid: usize, at: usize) {
+        let slack = i64::from(simplex.slack(eid));
+        self.at[eid] = at;
+        if simplex.n_tree_node[simplex.e_src_id[eid]] {
+            self.key[eid] = slack + self.moved;
+            self.leaving.insert((self.key[eid], eid));
+        } else {
+            self.key[eid] = slack - self.moved;
+            self.entering.insert((self.key[eid], eid));
+        }
+    }
+
+    /// Takes in tree node `nid`: its edges to the nodes outside the tree cross,
+    /// and its edges to other tree nodes do not.
+    fn join(&mut self, simplex: &NetworkSimplex, nid: usize) {
+        for (at, &eid) in simplex.node_edges[nid].iter().enumerate() {
+            let other = simplex.opposite(eid, nid);
+            if !simplex.n_tree_node[other] {
+                self.insert(simplex, eid, at);
+            } else if simplex.e_src_id[eid] == other {
+                self.leaving.remove(&(self.key[eid], eid));
+            } else {
+                self.entering.remove(&(self.key[eid], eid));
+            }
+        }
+    }
+
+    /// The crossing edge of least slack, the lowest-indexed of those tying,
+    /// with its slack.
+    fn minimal_slack(&self) -> Option<(i32, usize)> {
+        let leaving = self.leaving.first().map(|&(key, eid)| (key - self.moved, eid));
+        let entering = self.entering.first().map(|&(key, eid)| (key + self.moved, eid));
+        let (slack, eid) = match (leaving, entering) {
+            (Some(leaving), Some(entering)) => leaving.min(entering),
+            (leaving, entering) => leaving.or(entering)?,
+        };
+        Some((slack as i32, eid))
+    }
+
+    /// Records the tree's nodes moving `shift` layers.
+    fn shift_tree(&mut self, shift: i32) {
+        self.moved += i64::from(shift);
+    }
+
+    /// The crossing edges that are tight.
+    fn tight(&self, simplex: &NetworkSimplex) -> Vec<TreeExit> {
+        let tight_leaving = self.moved;
+        let tight_entering = -self.moved;
+        let leaving = self
+            .leaving
+            .range((tight_leaving, 0)..=(tight_leaving, usize::MAX))
+            .map(|&(_, eid)| TreeExit {
+                node: simplex.e_src_id[eid],
+                edge: eid,
+                at: self.at[eid],
+            });
+        let entering = self
+            .entering
+            .range((tight_entering, 0)..=(tight_entering, usize::MAX))
+            .map(|&(_, eid)| TreeExit {
+                node: simplex.e_tgt_id[eid],
+                edge: eid,
+                at: self.at[eid],
+            });
+        leaving.chain(entering).collect()
+    }
+}
