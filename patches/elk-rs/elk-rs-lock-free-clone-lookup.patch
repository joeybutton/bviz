+/// A clone function is leaked on registration, so a lookup hands it out without
+/// holding the lock or counting references to it.
+static CLONE_REGISTRY: OnceLock<Mutex<HashMap<TypeId, &'static CloneFn>>> = OnceLock::new();
+/// Advanced by every clone registration, invalidating every `CLONE_CACHE`.
+static CLONE_REGISTRY_GENERATION: AtomicU64 = AtomicU64::new(0);
+
+thread_local! {
+    /// This thread's lookups in `CLONE_REGISTRY`, misses included, as of the
+    /// generation beside them.
+    static CLONE_CACHE: RefCell<(u64, FxHashMap<TypeId, Option<&'static CloneFn>>)> =
+        RefCell::new((0, FxHashMap::default()));
+}
+
+fn clone_registry() -> &'static Mutex<HashMap<TypeId, &'static CloneFn>> {
+    CLONE_REGISTRY.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+fn registered_clone_fn(type_id: TypeId) -> Option<&'static CloneFn> {
+    clone_registry().lock().get(&type_id).copied()
+}
+
+fn lookup_clone_fn(type_id: TypeId) -> Option<&'static CloneFn> {
+    let generation = CLONE_REGISTRY_GENERATION.load(Ordering::Acquire);
+    CLONE_CACHE
+        .try_with(|cache| {
+            let mut cache = cache.borrow_mut();
+            let (cached_generation, fns) = &mut *cache;
+            if *cached_generation != generation {
+                fns.clear();
+                *cached_generation = generation;
+            }
+            *fns
+                .entry(type_id)
+                .or_insert_with(|| registered_clone_fn(type_id))
+        })
+        .unwrap_or_else(|_| registered_clone_fn(type_id))
+}
 
