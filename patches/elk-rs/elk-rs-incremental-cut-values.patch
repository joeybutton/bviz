+/// Stands for no edge in an edge index: the parent and entry edge of the root of
+/// the post-order numbering, the parent edge of a node outside the spanning tree,
+/// and the stale edge of a node with none.
+const NO_EDGE: usize = usize::MAX;
+
+/// Scratch for recomputing the cut values an exchange invalidates, kept empty
+/// between exchanges.
+#[derive(Default)]
+struct StaleCutvalues {
+    /// Each stale tree edge, with its endpoint away from the cut-value root.
+    edges: Vec<(usize, usize)>,
+    /// The stale tree edge from each node toward the cut-value root, or `NO_EDGE`.
+    edge_up: Vec<usize>,
+    /// How many stale tree edges not yet recomputed reach each node from away
+    /// from the cut-value root.
+    below: Vec<u32>,
+    /// The stale edges whose cut value can be recomputed next.
+    ready: Vec<(usize, usize)>,
+}
+
+impl StaleCutvalues {
+    fn mark(&mut self, eid: usize, far: usize, near: usize) {
+        if self.edge_up[far] == NO_EDGE {
+            self.edge_up[far] = eid;
+            self.below[near] += 1;
+            self.edges.push((eid, far));
+        }
+    }
+}
 
