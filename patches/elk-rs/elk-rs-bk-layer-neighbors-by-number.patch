+/// The node above node `node_id` in its layer. `NeighborhoodInformation`
+/// numbers the nodes layer by layer in their order, so it is the node numbered
+/// one less, unless `node_id` heads its layer.
+fn upper_neighbor(node_id: usize, ni: &NeighborhoodInformation) -> Option<usize> {
+    (*ni.node_index.get(node_id)? > 0).then(|| node_id - 1)
+}
 
