+/// The node below node `node_id` in its layer: the node numbered one more, if
+/// that one is the next in the same layer.
+fn lower_neighbor(node_id: usize, ni: &NeighborhoodInformation) -> Option<usize> {
+    let index = *ni.node_index.get(node_id)?;
+    let next = node_id + 1;
+    (ni.node_index.get(next) == Some(&(index + 1))).then_some(next)
