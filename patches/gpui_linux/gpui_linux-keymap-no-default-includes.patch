Compile the Wayland keymap without default include paths

xkb_context_new returns NULL when none of libxkbcommon's default include
paths exist, which the xkbcommon crate's Context::new does not check, so a
host without xkb data crashes on the first keymap. The compositor sends
the keymap fully compiled, so compiling it needs no include paths.

--- a/crates/gpui_linux/src/linux/wayland/client.rs
+++ b/crates/gpui_linux/src/linux/wayland/client.rs
@@ -1655,7 +1655,7 @@
                     log::error!("Received keymap format {:?}, expected XkbV1", format);
                     return;
                 }
-                let xkb_context = xkb::Context::new(xkb::CONTEXT_NO_FLAGS);
+                let xkb_context = xkb::Context::new(xkb::CONTEXT_NO_DEFAULT_INCLUDES);
                 let keymap = unsafe {
                     xkb::Keymap::new_from_fd(
                         &xkb_context,
