+/// How long startup waits on the portal before the first window is drawn with
+/// the default appearance.
+const INITIAL_APPEARANCE_TIMEOUT: Duration = Duration::from_millis(250);
+
+/// The portal's color scheme, read synchronously so the first frame is drawn in
+/// it; `None` when the portal is absent or does not answer in time.
+pub fn initial_window_appearance() -> Option<WindowAppearance> {
+    smol::block_on(smol::future::or(
+        async {
+            let scheme = Settings::new().await.ok()?.color_scheme().await.ok()?;
+            Some(window_appearance_from_color_scheme(scheme))
+        },
+        async {
+            smol::Timer::after(INITIAL_APPEARANCE_TIMEOUT).await;
+            None
+        },
+    ))
+}
+
 pub struct XDPEventSource {
     channel: Channel<Event>,
 }
