+impl Dispatch<wl_data_source::WlDataSource, DragSourceData> for WaylandClientStatePtr {
+    fn event(
+        this: &mut Self,
+        data_source: &wl_data_source::WlDataSource,
+        event: wl_data_source::Event,
+        _: &DragSourceData,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let client = this.get_client();
+        let mut state = client.borrow_mut();
+
+        let cancelled = match event {
+            // What the drag carries is a view this process holds, which no
+            // reader outside it could make anything of, so the pipe is closed
+            // with nothing written to it.
+            wl_data_source::Event::Send { fd, .. } => {
+                drop(File::from(fd));
+                return;
+            }
+            wl_data_source::Event::DndDropPerformed => {
+                if let Some(drag) = drag_carried_on(&mut state, data_source) {
+                    drag.dropped = true;
+                }
+                return;
+            }
+            wl_data_source::Event::DndFinished => false,
+            wl_data_source::Event::Cancelled => true,
+            _ => return,
+        };
+
+        let Some(drag) = drag_carried_on(&mut state, data_source) else {
+            // Nothing of the drag this source carried is left to let go of
+            // but the source.
+            data_source.destroy();
+            return;
+        };
+
+        let ended = match (cancelled, drag.dropped) {
+            (false, _) => PlatformDragEnd::Taken,
+            (true, true) => PlatformDragEnd::Released,
+            (true, false) => PlatformDragEnd::Cancelled,
+        };
+        // An xdg_toplevel_drag_v1 destroyed before the compositor has reported
+        // the drag over raises `ongoing_drag`, and the reports it takes as
+        // that are `dnd_drop_performed` and `cancelled`.
+        if (drag.dropped || cancelled)
+            && let Some(toplevel_drag) = &drag.toplevel_drag
+        {
+            toplevel_drag.destroy();
+        }
+        data_source.destroy();
+        drag.icon.destroy();
+        drag.buffer.destroy();
+        let origin = drag.origin.clone();
+        state.outgoing_drag = None;
+
+        drop(state);
+        origin.handle_input(PlatformInput::PlatformDrag(PlatformDragEvent::Ended(ended)));
+    }
+}
