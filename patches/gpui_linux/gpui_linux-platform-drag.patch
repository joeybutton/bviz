+impl Dispatch<wl_data_source::WlDataSource, DragSourceData> for WaylandClientStatePtr {
+    fn event(
+        this: &mut Self,
+        data_source: &wl_data_source::WlDataSource,
+        event: wl_data_source::Event,
+        _: &DragSourceData,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let client = this.get_client();
+        let mut state = client.borrow_mut();
+
+        let ended = match event {
+            // What the drag carries is a view this process holds, which no
+            // reader outside it could make anything of, so the pipe is closed
+            // with nothing written to it.
+            wl_data_source::Event::Send { fd, .. } => {
+                drop(File::from(fd));
+                return;
+            }
+            wl_data_source::Event::DndDropPerformed => {
+                if let Some(drag) = state.outgoing_drag.as_mut() {
+                    drag.dropped = true;
+                }
+                return;
+            }
+            wl_data_source::Event::DndFinished => PlatformDragEnd::Taken,
+            wl_data_source::Event::Cancelled => {
+                match state.outgoing_drag.as_ref().is_some_and(|drag| drag.dropped) {
+                    true => PlatformDragEnd::Released,
+                    false => PlatformDragEnd::Cancelled,
+                }
+            }
+            _ => return,
+        };
+
+        data_source.destroy();
+        let Some(drag) = state.outgoing_drag.take() else {
+            return;
+        };
+        drag.icon.destroy();
+        drag.buffer.destroy();
+
+        drop(state);
+        drag.origin
+            .handle_input(PlatformInput::PlatformDrag(PlatformDragEvent::Ended(ended)));
+    }
+}
