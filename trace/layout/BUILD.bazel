load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "layout",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_trace_layout",
    visibility = [
        "//ui/theme:__pkg__",
        "//ui/trace:__pkg__",
    ],
    deps = [
        "//trace/profile",
        "@crates//:rustc-hash",
    ],
)

rust_test(
    name = "layout_test",
    crate = ":layout",
)

rust_binary(
    name = "bench_flame",
    srcs = ["bench/flame.rs"],
    crate_name = "bench_flame",
    deps = [
        ":layout",
        "//alloc",
        "//trace/profile",
    ],
)
